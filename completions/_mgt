#compdef mgt

autoload -U is-at-least

_mgt() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_mgt_commands" \
"*::: :->mgt" \
&& ret=0
    case $state in
    (mgt)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:mgt-command-$line[1]:"
        case $line[1] in
            (analyze)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
':identifier -- A WildFly version (e.g. 39, 26.1):_default' \
&& ret=0
;;
(neo4j)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_mgt__subcmd__neo4j_commands" \
"*::: :->neo4j" \
&& ret=0

    case $state in
    (neo4j)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:mgt-neo4j-command-$line[1]:"
        case $line[1] in
            (start)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
':identifier -- A WildFly version, version range or a feature pack identifier:_default' \
":: :_mgt__subcmd__neo4j__subcmd__start_commands" \
"*::: :->start" \
&& ret=0

    case $state in
    (start)
        words=($line[2] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:mgt-neo4j-start-command-$line[2]:"
        case $line[2] in
            (stop)
_arguments "${_arguments_options[@]}" : \
'-a[Stop all running Neo4J model databases.]' \
'--all[Stop all running Neo4J model databases.]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
'::identifier -- A WildFly version, version range or a feature pack identifier:_default' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_mgt__subcmd__neo4j__subcmd__start__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:mgt-neo4j-start-help-command-$line[1]:"
        case $line[1] in
            (stop)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_mgt__subcmd__neo4j__subcmd__help_commands" \
