&& ret=0

    case $state in
    (start)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:mgt-help-neo4j-start-command-$line[1]:"
        case $line[1] in
            (stop)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_mgt_commands] )) ||
_mgt_commands() {
    local commands; commands=(
'analyze:Analyze the management model of a WildFly instance and build an image with a Neo4J database' \
'neo4j:Start and stop a Neo4J model database' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'mgt commands' commands "$@"
}
